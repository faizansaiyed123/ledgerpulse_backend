ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ledgerpulse_db
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Firebase Admin (service-account values)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or use GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

# Optional platform-admin users (comma-separated Firebase UIDs)
PLATFORM_ADMIN_UIDS=

# SMTP is required for invoice email, team invitations, and public contact delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=LedgerPulse
SMTP_USE_TLS=true
SMTP_USE_SSL=false
CONTACT_INBOX_EMAIL=
